# Local: leave empty — Vite proxies /api → admin (VITE_API_PROXY_TARGET).
# Production (Vercel): set to your live admin URL (no trailing slash).
# Example: https://floortexa-admin.vercel.app
VITE_API_BASE_URL=

# Local only — admin Next.js origin for the Vite proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
